BRIDGE_BOT_TOKEN=your_bot_token_here
BRIDGE_DATA_DIR=./data
BRIDGE_SEND_POLICY=approve
# BRIDGE_AUTO_SEND_CHAT_IDS=[]  # JSON-список chat_id с автоотправкой, например [123,456]
# BRIDGE_MCP_TRANSPORT=stdio  # stdio (default) или streamable-http
# BRIDGE_MCP_HOST=127.0.0.1  # хост MCP-сервера при streamable-http
# BRIDGE_MCP_PORT=8765  # порт MCP-сервера при streamable-http
# BRIDGE_DEEPGRAM_API_KEY=  # ключ Deepgram: расшифровка голосовых/аудио/видеокружков в текст (опционально)
# BRIDGE_MEDIA_RETENTION_DAYS=0  # 0 = хранить вечно; файлы медиа старше N дней удаляются, тексты остаются
